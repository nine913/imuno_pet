DB_HOST=localhost
DB_USER=root
DB_PASSWORD=root
DB_NAME=imunopet
PORT=3000

# Segredo usado para assinar/validar os tokens JWT. NUNCA reutilize este valor em produção;
# gere um novo com: node -e "console.log(require('crypto').randomBytes(48).toString('hex'))"
JWT_SECRET=4c0d77515a6099efc8f60d2f71aa43ab2b169b7dd8d5e2ef3001302668d3779a17160d8e71e7c758f24fdd7cb34b29ff
JWT_EXPIRES_IN=8h

# Origens de frontend autorizadas a chamar a API (separadas por vírgula)
CORS_ORIGIN=http://localhost:3000,http://localhost:3001,http://127.0.0.1:5500

# URL do frontend usada para montar o link enviado no e-mail de redefinição de senha
FRONTEND_URL=http://localhost:3001

# SMTP opcional: se SMTP_HOST não for definido, o e-mail de redefinição de senha é apenas
# registrado no console do servidor (útil em desenvolvimento, sem precisar de credenciais reais).
# SMTP_HOST=smtp.exemplo.com
# SMTP_PORT=587
# SMTP_SECURE=false
# SMTP_USER=usuario
# SMTP_PASSWORD=senha
# SMTP_FROM=ImunoPet Brasil <no-reply@imunopet.com.br>