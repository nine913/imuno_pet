DB_HOST=localhost
DB_USER=seu_usuario
DB_PASSWORD=sua_senha
DB_NAME=imunopet
PORT=3000

# Em produção defina NODE_ENV=production (o cookie de sessão vira Secure/HTTPS-only).
NODE_ENV=development

# Gere um valor único por ambiente: node -e "console.log(require('crypto').randomBytes(48).toString('hex'))"
JWT_SECRET=troque_este_valor
JWT_EXPIRES_IN=8h

# Origens de frontend autorizadas a chamar a API (separadas por vírgula)
CORS_ORIGIN=http://localhost:3000,http://localhost:3001

# URL do frontend usada para montar o link enviado no e-mail de redefinição de senha
FRONTEND_URL=http://localhost:3001

# SMTP opcional: sem SMTP_HOST, o e-mail de redefinição de senha é apenas registrado no console.
# SMTP_HOST=smtp.exemplo.com
# SMTP_PORT=587
# SMTP_SECURE=false
# SMTP_USER=usuario
# SMTP_PASSWORD=senha
# SMTP_FROM=ImunoPet Brasil <no-reply@imunopet.com.br>
