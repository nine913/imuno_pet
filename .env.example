# Variáveis usadas pelo docker-compose.yml (na raiz do projeto).
# Copie para ".env" e ajuste antes de rodar `docker compose up`.

DB_PASSWORD=root
DB_NAME=imunopet

# Gere um valor único: node -e "console.log(require('crypto').randomBytes(48).toString('hex'))"
JWT_SECRET=troque_este_valor
JWT_EXPIRES_IN=8h

CORS_ORIGIN=http://localhost:3001
FRONTEND_URL=http://localhost:3001
NEXT_PUBLIC_API_URL=http://localhost:3000

# SMTP opcional (sem isso, o e-mail de redefinição de senha só é logado no console do backend)
SMTP_HOST=
SMTP_PORT=
SMTP_SECURE=
SMTP_USER=
SMTP_PASSWORD=
SMTP_FROM=
